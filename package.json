{
  "name": "evotrek",
  "version": "1.0.0",
  "description": "EvoTrek E-commerce Website",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "cross-env": "^10.1.0"
  },
  "scripts": {
    "start": "node src/index.js",
