<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>EvoTrek-Profile</title>
    <link rel="stylesheet" href="/profile.css">
</head>
<body>
    <div class="profile-container">
        <h1>Hello, <%= user.name %> 👋</h1>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-info" style="background: #e3f2fd; color: #1565c0; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
                <%= message %>
            </div>
        <% } %>

        <!-- Demo mode notice - password update disabled -->
        <div class="password-update" style="opacity: 0.6;">
            <h2>Update Password</h2>
            <p style="color: #666; font-style: italic;">Password update is disabled in demo mode</p>
        </div>

        <div class="order-history-header">
            <h2>🛒 Your Order History</h2>
            <button type="button" class="clear-history-btn" onclick="clearDemoOrders()">🗑️ Clear Order History</button>
        </div>

        <!-- Orders will be loaded from localStorage via JavaScript -->
        <div id="demo-orders-container">
            <p class="no-orders">Loading orders from local storage...</p>
        </div>

        <a href="/" class="back-home">🏠</a>
    </div>

    <script>
        // Load orders from localStorage for demo mode
        function loadDemoOrders() {
            const container = document.getElementById('demo-orders-container');
            const orders = JSON.parse(localStorage.getItem('demoOrders')) || [];
            
            if (orders.length === 0) {
                container.innerHTML = '<p class="no-orders">You haven\'t ordered anything yet.</p>';
                return;
            }
            
            let html = '';
            orders.forEach(order => {
                const orderDate = new Date(order.date);
                const deliveryDate = new Date(order.date);
                const randomDays = Math.floor(Math.random() * 5) + 3;
                deliveryDate.setDate(deliveryDate.getDate() + randomDays);
                if (deliveryDate.getDay() === 0) {
                    deliveryDate.setDate(deliveryDate.getDate() + 1);
                }
                
                html += `
                    <div class="order-card">
                        <h3>Order Date: ${orderDate.toLocaleDateString()}</h3>
                        <h4>Delivery Date: ${deliveryDate.toLocaleDateString()}</h4>
                        <div class="items-list">
                `;
                
                order.items.forEach(item => {
                    html += `
                        <div class="item-card">
                            <img src="${item.image}" alt="Product Image">
                            <div class="item-details">
                                <h4>${item.name}</h4>
                                <p>Price: ₹${item.price}</p>
                                <p>Quantity: ${item.quantity}</p>
                                <p>Size: ${item.size} | Color: ${item.color}</p>
                            </div>
                        </div>
                    `;
                });
                
                html += `
                        </div>
                        <h4>Total Paid: ₹${order.total}</h4>
                    </div>
                `;
            });
            
            container.innerHTML = html;
        }
        
        function clearDemoOrders() {
            if (confirm('Are you sure you want to clear your order history?')) {
                localStorage.removeItem('demoOrders');
                loadDemoOrders();
            }
        }
        
        // Load orders when page loads
        loadDemoOrders();
    </script>
</body>
</html>
